# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Rust 编译产物（cargo target 可达数 GB）
/rust/target/

# 捆绑的 Android JDK（约 300MB，不应入库）
/android/.jdk/

# Rust 插件构建缓存
/rust_builder/**/build/

# Reasonix 会话元数据
/.reasonix/
/reasonix.toml

# Android gradle 构建产物
/android/build/
/android/app/build/
/android/.gradle/
/android/local.properties

# 测试输出报告
#
# 注意：这条规则曾误伤 rust/src/parser.rs 的回归测试 fixture
# (test_list.html / test_detail.html)。那两个文件本来要与测试一起入库，
# 结果被一并忽略、从未提交，导致测试在干净检出的仓库上必然失败。
# 现在改用 fixtures/ 目录存放输入样本，与输出报告分开命名。
/test_*.html
!/rust/fixtures/
!/rust/fixtures/**

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android APK & installation packages
*.apk
安卓*/

# Debug screenshots / verification dumps
#
# 这些都是排查问题时临时产生的产物，不应该进版本库，也不应该堆在根目录。
# 之前的 rel*.log / kt*.log / screen_*.png / verify_* 就是这样攒下来的。
# 约定：验证截图一律用 verify_*.png / verify_*.jpg 命名，跑完随手删。
screen_*.png
verify_*.png
verify_*.jpg

# Rust NDK build output (generated by buildRustNdk task)
/android/app/src/main/jniLibs/

# WorkBuddy 项目本地数据（memory / skills / 会话产物）。
# 内含设备序列号、本机路径等仅对本机有意义的信息，不入库。
/.workbuddy/

