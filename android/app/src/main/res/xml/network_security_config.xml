<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow all HTTPS traffic (standard TLS) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    <!-- Allow e-hentai and exhentai domains -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">e-hentai.org</domain>
        <domain includeSubdomains="true">exhentai.org</domain>
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </domain-config>
</network-security-config>
